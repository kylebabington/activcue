{
  "name": "activcue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "start:all": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run --exclude \"e2e/**\" --exclude \"scripts/demo/**\"",
    "test:watch": "vitest --exclude \"e2e/**\" --exclude \"scripts/demo/**\"",
    "test:e2e": "playwright test",
    "demo:record": "playwright test -c scripts/demo/playwright.demo.config.js landing-demo.spec.js",
    "demo:record:playground": "playwright test -c scripts/demo/playwright.demo.config.js landing-demo.spec.js",
    "demo:publish": "node scripts/demo/publish-demo-video.mjs",
    "create-subscription-product": "node server/scripts/createSubscriptionProduct.js",
    "presets:build-expanded": "node scripts/buildExpandedPresets.mjs",
    "presets:verify-expanded": "node scripts/verifyExpandedPresets.mjs",
    "presets:import-shared": "node scripts/importPresetsToSharedLibrary.mjs",
    "presets:audit-age-fit": "node scripts/auditActivityAgeFit.mjs --source=presets",
    "server:check-esm": "node scripts/checkServerEsmImports.mjs",
    "server:smoke": "node scripts/smokeServerImport.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "@zxing/browser": "^0.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "openai": "^4.77.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.15.1",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "supabase": "2.110.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": "24.x"
  }
}
