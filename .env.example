# For local E2E / safe Playwright: use local Supabase (Docker).
#   npx supabase start
#   npx supabase status   # copy API URL + anon/publishable key
# Never point Playwright / CI at the production project.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_TURNSTILE_SITE_KEY=
# Optional override for Settings / legal mailto links
# VITE_SUPPORT_EMAIL=support@familyflow.app
