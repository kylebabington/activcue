NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173

OPENAI_API_KEY=

# For local E2E / safe Playwright: use local Supabase (Docker).
#   npx supabase start
#   npx supabase status   # copy API URL, anon/publishable, service_role/secret
# Never point Playwright / CI at the production project.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1

# Stripe — obtain keys from https://dashboard.stripe.com/apikeys
# Accept Managed Payments Terms of Service in the Stripe Dashboard before charging.
# Local E2E and GitHub Actions must use Stripe test-mode keys only (sk_test_…).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Required at server boot. Local webhooks:
#   stripe listen --forward-to localhost:3001/api/billing/webhook
# Then paste the whsec_… signing secret printed by the CLI.
STRIPE_WEBHOOK_SECRET=
# One-time product setup: node server/scripts/createSubscriptionProduct.js
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=

IP_HASH_SECRET=

# ---------------------------------------------------------------------------
# GitHub Actions E2E (repository secrets — NOT these local names)
# Supabase is started with `supabase start` on the runner (no TEST_SUPABASE_*).
# ---------------------------------------------------------------------------
# TEST_STRIPE_SECRET_KEY          (must be sk_test_…)
# TEST_STRIPE_WEBHOOK_SECRET
# TEST_STRIPE_MONTHLY_PRICE_ID
# TEST_STRIPE_ANNUAL_PRICE_ID
# TEST_OPENAI_API_KEY
# Optional repo variable: FAMILYFLOW_BLOCKED_SUPABASE_HOSTS
#   Comma-separated production Supabase hostnames CI must refuse.
